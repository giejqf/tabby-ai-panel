{
  "name": "tabby-ai-panel",
  "version": "0.1.2",
  "description": "An autonomous AI agent panel for Tabby: works across terminal tabs, keeps persistent, resumable sessions, and runs commands with reviewable approvals.",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "ai",
    "agent"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "TABBY_DEV=1 webpack --progress --color --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "link:tabby": "node scripts/link-plugin.mjs",
    "pack": "node scripts/pack.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "author": "Qianfan Jiang",
  "homepage": "https://github.com/giejqf/tabby-ai-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giejqf/tabby-ai-panel.git"
  },
  "bugs": {
    "url": "https://github.com/giejqf/tabby-ai-panel/issues"
  },
  "devDependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@babel/core": "^7.24.0",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@ngtools/webpack": "^15.2.10",
    "@tabby-gang/to-string-loader": "^1.1.7-beta.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.11.0",
    "babel-loader": "^9.1.3",
    "bootstrap": "^5.3.0",
    "css-loader": "^6.10.0",
    "dompurify": "^3.1.0",
    "marked": "^12.0.0",
    "rxjs": "^7.8.1",
    "sass": "^1.71.0",
    "sass-loader": "^14.1.0",
    "source-map-loader": "^5.0.0",
    "style-loader": "^3.3.4",
    "tabby-core": "npm:tabby-core@*",
    "tabby-settings": "npm:tabby-settings@*",
    "tabby-terminal": "npm:tabby-terminal@*",
    "tsx": "^4.23.13",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "peerDependencies": {
    "@angular/animations": "^15",
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "rxjs": "^7",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "peerDependenciesMeta": {
    "@angular/animations": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@angular/platform-browser": {
      "optional": true
    },
    "@ng-bootstrap/ng-bootstrap": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "tabby-core": {
      "optional": true
    },
    "tabby-settings": {
      "optional": true
    },
    "tabby-terminal": {
      "optional": true
    }
  },
